<!DOCTYPE html>
<html>
<head>
    <title>Product Management System</title>

    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: linear-gradient(to right, #667eea, #764ba2);
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .container {
            background: white;
            width: 80%;
            max-width: 900px;
            padding: 40px;
            border-radius: 20px;
            text-align: center;
            box-shadow: 0px 10px 30px rgba(0,0,0,0.2);
        }

        h1 {
            color: #333;
            font-size: 40px;
        }

        p {
            color: #666;
            font-size: 18px;
        }

        .cards {
            display: flex;
            justify-content: space-around;
            margin-top: 30px;
        }

        .card {
            width: 25%;
            padding: 20px;
            background: #f5f5f5;
            border-radius: 15px;
        }

        .card h3 {
            color: #667eea;
        }

        .btn {
            margin-top: 30px;
            padding: 12px 35px;
            border: none;
            border-radius: 30px;
            background: #667eea;
            color: white;
            font-size: 18px;
            cursor: pointer;
        }

        .btn:hover {
            background: #764ba2;
        }

        footer {
            margin-top: 30px;
            color: #888;
        }
    </style>
</head>

<body>

    <div class="container">

        <h1>🛒 Product Management System</h1>

        <p>
            Manage your products easily with our modern web application.
        </p>

        <div class="cards">

            <div class="card">
                <h3>📦 Products</h3>
                <p>
                    Add, edit and manage product information.
                </p>
            </div>

            <div class="card">
                <h3>⚡ Performance</h3>
                <p>
                    Fast and reliable ASP.NET MVC application.
                </p>
            </div>

            <div class="card">
                <h3>🚀 Deployment</h3>
                <p>
                    Docker + AWS EC2 + CI/CD pipeline.
                </p>
            </div>

        </div>

        <button class="btn">
            Get Started
        </button>

        <footer>
            © 2026 Product Management System
        </footer>

    </div>

</body>
</html>